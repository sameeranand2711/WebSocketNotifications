{
  "NotificationProducer": {
    "ProducerName": "notification-producer",
    "Topic": "notifications"
  },
  "KafkaProducerClients": {
    "Producers": [
      {
        "Name": "notification-producer",
        "BootstrapServers": "localhost:9092,localhost:29092",
        "LingerMs": 5,
        "BatchSize": 1048576,
        "CompressionType": "Lz4",
        "Acks": "All",
        "EnableIdempotence": true,
        "QueueBufferingMaxMessages": 100000,
        "QueueBufferingMaxKbytes": 262144,
        "ChannelCapacity": 1000,
        "EnableSharding": false,
        "ShardCount": 1,
        "EnableMetrics": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "KafkaHighThroughput": "Information"
    }
  }
}

@NotificationProducer_HostAddress = http://localhost:5001

GET {{NotificationProducer_HostAddress}}/
Accept: application/json

### Users
POST {{NotificationProducer_HostAddress}}/api/notifications/users
Content-Type: application/json

{
  "users": ["user-1", "user-2"],
  "payload": { "score": 7 },
  "key": "user:user-1"
}

### Subscriptions
POST {{NotificationProducer_HostAddress}}/api/notifications/subscriptions
Content-Type: application/json

{
  "subscriptions": ["group:operators", "tenant:abc:event:score.changed"],
  "payload": { "text": "Operations update" }
}

### Combined routing
POST {{NotificationProducer_HostAddress}}/api/notifications
Content-Type: application/json

{
  "userIds": ["user-1"],
  "subscriptions": ["group:operators", "feed:match-42", "event:score.changed"],
  "payload": { "score": 10 },
  "key": "order:42"
}

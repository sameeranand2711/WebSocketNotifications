{
  "WebSocketNotifications": {
    "EndpointPath": "/ws/notifications",
    "HeartbeatEnabled": true,
    "HeartbeatInterval": "00:00:30",
    "HeartbeatTimeout": "00:00:10",
    "CompressionEnabled": false,
    "MaxIncomingMessageSize": 65536,
    "MaxOutgoingMessageSize": 262144,
    "OutgoingBufferCapacity": 128,
    "SlowClientPolicy": "Disconnect"
  },
  "KafkaAdapter": {
    "ChannelCapacity": 256,
    "ApplicationName": "websocket-notifications"
  },
  "KafkaConsumerWorkers": {
    "Consumers": [
      {
        "Name": "websocket-notifications",
        "BootstrapServers": "localhost:9092,localhost:29092",
        "Topics": [ "notifications" ],
        "AutoOffsetReset": "Latest",
        "ChannelCapacity": 1000,
        "BatchMaxSize": 100,
        "BatchMaxLingerMs": 50,
        "PollTimeoutMs": 100,
        "MaxDegreeOfParallelism": 0,
        "ShutdownDrainTimeoutSeconds": 30,
        "ShutdownMode": "Graceful",
        "ProcessingMode": "OrderedByPartition",
        "RetryMaxAttempts": 3,
        "RetryInitialDelayMs": 100,
        "PoisonMessageBehavior": "StopConsumer"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "KafkaHighThroughput": "Information"
    }
  }
}
